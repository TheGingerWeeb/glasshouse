    {"id": "roblox", "name": "Roblox", "category": "gaming", "host": "roblox.com", "url": "https://www.roblox.com/users/profile?username={username}", "check": "https://users.roblox.com/v1/usernames/users", "method": "POST", "post_json": {"usernames": ["{username}"], "excludeBannedUsers": true}, "kind": "json", "json_path": "data.0.id", "absent_status": [404]},
