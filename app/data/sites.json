{
  "version": 1,
  "note": "Curated seed list. kind=json reads an API field, kind=text looks for marker strings, kind=status trusts 404/410 and treats 200 as found. subdomain=true means a DNS failure is treated as 'no account'. manual=true means the site blocks automation and is offered as a self-check link.",
  "sites": [
    {"id": "github", "name": "GitHub", "category": "dev", "host": "github.com", "url": "https://github.com/{username}", "check": "https://api.github.com/users/{username}", "kind": "json", "json_path": "login"},
